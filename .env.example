DISCORD_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_application_client_id
DISCORD_GUILD_ID=optional_test_guild_id
BOOST_API_KEY=replace_with_api_key
BOOST_API_URL=https://pandaboost.de/api/v2
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
QUEUE_CONCURRENCY=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=8
CREDIT_CURRENCY=USD
# Provider rate is charge / CREDIT_RATE_DIVISOR for one unit of quantity.
CREDIT_RATE_DIVISOR=1000
# Reseller margin added to the provider price shown to customers and charged for orders.
PROFIT_PERCENT=20
DATA_DIR=data
# Optional crypto deposits via NOWPayments. Keep these values private.
CRYPTO_API_KEY=
CRYPTO_IPN_SECRET=
CRYPTO_SANDBOX=true
CRYPTO_PRICE_CURRENCY=usd
CRYPTO_PAY_CURRENCY=usdttrc20
CRYPTO_CALLBACK_URL=https://your-public-host.example/crypto/webhook
CRYPTO_WEBHOOK_PORT=0
